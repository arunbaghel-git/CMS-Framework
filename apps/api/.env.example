# Core
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
# Monorepo dev me migrations repo root pe hain, apps/api me nahi
MIGRATIONS_DIR=../../migrations
SITE_URL=http://localhost:3000
ADMIN_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=merncms

# Auth — har client ke alag secrets, kabhi share nahi
# generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=change-me-min-32-characters-long-secret
JWT_REFRESH_SECRET=change-me-min-32-characters-long-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=24h
REFRESH_TOKEN_TTL_REMEMBER=7d
COOKIE_SECURE=false

# Media
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20

# S3 — STORAGE_DRIVER=s3 hone pe zaroori
# S3_ENDPOINT=
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# CDN_BASE_URL=

# Next.js revalidation
REVALIDATE_SECRET=change-me-min-32-characters-long-secret

# Mail
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=

# Observability
# SENTRY_DSN=
